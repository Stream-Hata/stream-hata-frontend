{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"outDir": "./out-tsc/app",
		"types": []
	},
	"files": [
		"src/main.ts"
	],
	"include": [
		"src/**/*.d.ts",
		"../shared/**/*.ts"
	],
	"exclude": [
		"src/**/*.spec.ts",
		"../shared/**/*.spec.ts",
		"../shared/**/*.test.ts",
		"../shared/eslint/**"
	]
}
