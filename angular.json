{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "pnpm"
	},
	"newProjectRoot": "projects",
	"projects": {
		"nameless-streamhata": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss",
					"changeDetection": "OnPush",
					"name": "component",
					"addTypeToClassName": true
				},
				"@schematics/angular:directive": {
					"addTypeToClassName": true,
					"name": "directive"
				},
				"@schematics/angular:service": {
					"addTypeToClassName": true,
					"name": "service"
				}
			},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"stylePreprocessorOptions": {
							"includePaths": [
								"./"
							]
						},
						"browser": "src/main.ts",
						"tsConfig": "tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							},
							{
								"glob": "**/*",
								"input": "node_modules/@taiga-ui/icons/src",
								"output": "assets/taiga-ui/icons"
							}
						],
						"styles": [
							"node_modules/@taiga-ui/styles/taiga-ui-theme.less",
							"node_modules/@taiga-ui/styles/taiga-ui-fonts.less",
							"src/styles.scss"
						]
					},
					"configurations": {
						"production": {
							"optimization": {
								"fonts": false
							},
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "10MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "16kB",
									"maximumError": "10MB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"options": {
						"proxyConfig": "proxy.conf.json"
					},
					"configurations": {
						"production": {
							"buildTarget": "nameless-streamhata:build:production"
						},
						"development": {
							"buildTarget": "nameless-streamhata:build:development"
						}
					},
					"defaultConfiguration": "development"
				},
				"test": {
					"builder": "@angular/build:unit-test"
				}
			}
		},
		"streamhata-admin": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss",
					"changeDetection": "OnPush",
					"name": "component",
					"addTypeToClassName": true
				},
				"@schematics/angular:directive": {
					"addTypeToClassName": true,
					"name": "directive"
				},
				"@schematics/angular:service": {
					"addTypeToClassName": true,
					"name": "service"
				}
			},
			"root": "admin",
			"sourceRoot": "admin/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"stylePreprocessorOptions": {
							"includePaths": [
								"./"
							]
						},
						"browser": "admin/src/main.ts",
						"tsConfig": "admin/tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							},
							{
								"glob": "**/*",
								"input": "node_modules/@taiga-ui/icons/src",
								"output": "assets/taiga-ui/icons"
							}
						],
						"styles": [
							"src/styles.scss"
						],
						"index": "admin/src/index.html",
						"outputPath": "dist/streamhata-admin"
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "2mb",
									"maximumError": "5mb"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "streamhata-admin:build:production"
						},
						"development": {
							"buildTarget": "streamhata-admin:build:development"
						}
					},
					"defaultConfiguration": "development"
				}
			}
		}
	}
}
