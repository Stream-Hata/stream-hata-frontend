{
	"name": "nameless-streamhata",
	"version": "1.2.1-alpha",
	"scripts": {
		"ng": "ng",
		"start": "nx serve nameless-streamhata",
		"build": "nx run nameless-streamhata:build",
		"prebuild": "node scripts/write-version.mjs",
		"watch": "nx run nameless-streamhata:build --watch --configuration development",
		"test": "nx run nameless-streamhata:test --watch=false",
		"prepare": "husky",
		"commitlint": "commitlint --edit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "nx run nameless-streamhata:build --configuration development && eslint apps packages --quiet",
		"lint:web": "eslint apps packages --quiet",
		"test:coverage": "nx run nameless-streamhata:test --watch=false --coverage --coverage-reporters=lcovonly --coverage-reporters=text-summary",
		"build:admin": "nx run streamhata-admin:build",
		"nx": "nx",
		"affected:build": "nx affected -t build",
		"affected:test": "nx affected -t test",
		"graph": "nx graph"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*.{ts,mts,cts,tsx}": [
			"eslint --fix"
		],
		"*.scss": [
			"stylelint --fix"
		],
		"*.html": [
			"eslint --fix"
		]
	},
	"private": true,
	"packageManager": "pnpm@11.5.2",
	"dependencies": {
		"@angular/cdk": "^22.2.3",
		"@angular/common": "^22.2.3",
		"@angular/compiler": "^22.2.3",
		"@angular/core": "^22.2.3",
		"@angular/forms": "^22.2.3",
		"@angular/platform-browser": "^22.2.3",
		"@angular/router": "^22.2.3",
		"@ngrx/signals": "^22.0.1",
		"@stylistic/stylelint-plugin": "^5.3.0",
		"@taiga-ui/addon-charts": "^5.24.0",
		"@taiga-ui/addon-commerce": "^5.24.0",
		"@taiga-ui/addon-mobile": "^5.24.0",
		"@taiga-ui/addon-table": "^5.24.0",
		"@taiga-ui/cdk": "^5.24.0",
		"@taiga-ui/core": "^5.24.0",
		"@taiga-ui/editor": "5.7.1",
		"@taiga-ui/i18n": "^5.24.0",
		"@taiga-ui/icons": "^5.24.0",
		"@taiga-ui/kit": "^5.24.0",
		"@taiga-ui/layout": "^5.24.0",
		"@taiga-ui/polymorpheus": "^5.0.1",
		"@taiga-ui/styles": "^5.24.0",
		"@types/luxon": "^3.7.5",
		"feather-icons": "^4.29.2",
		"less": "^4.9.1",
		"luxon": "^3.7.2",
		"rxjs": "~7.8.0",
		"sql-formatter": "^15.9.0",
		"stylelint": "^17.15.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-order": "^8.1.1",
		"three": "^0.186.1",
		"tslib": "^2.3.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@angular/build": "^22.2.4",
		"@angular/cli": "^22.2.4",
		"@angular/compiler-cli": "^22.2.3",
		"@antfu/eslint-config": "^9.5.1",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@html-eslint/eslint-plugin": "^0.66.1",
		"@html-eslint/parser": "^0.66.1",
		"@nx/angular": "24.0.6",
		"@stream-hata/eslint-rules": "github:Stream-Hata/eslint-rules#d3e4748e14d15ec3e5c3fcca1a8017c4600b06d5",
		"@types/feather-icons": "^4.29.4",
		"@types/node": "^26.6.3",
		"@types/three": "^0.186.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^9.39.5",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"jsdom": "^28.0.0",
		"lint-staged": "^17.5.1",
		"nx": "24.0.6",
		"prettier": "^3.8.1",
		"typescript": "~6.0.2",
		"vitest": "^4.0.8"
	}
}
