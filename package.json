    "eslint": "^10.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
