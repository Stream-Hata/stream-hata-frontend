		"@angular/forms": "^22.0.0",
		"@angular/platform-browser": "^22.0.0",
		"@angular/router": "^22.0.0",
		"@ngrx/signals": "^22.0.1",
		"@stylistic/stylelint-plugin": "^5.3.0",
		"@taiga-ui/addon-commerce": "^5.24.0",
		"@taiga-ui/addon-mobile": "^5.24.0",
		"@taiga-ui/addon-table": "^5.24.0",
		"@taiga-ui/cdk": "^5.24.0",
		"@taiga-ui/core": "^5.24.0",
		"@taiga-ui/icons": "^5.24.0",
		"@taiga-ui/kit": "^5.24.0",
		"@taiga-ui/layout": "^5.24.0",
		"@types/luxon": "^3.7.5",
		"feather-icons": "^4.29.2",
		"less": "^4.9.1",
		"luxon": "^3.7.2",
		"rxjs": "~7.8.0",
		"sql-formatter": "^15.9.0",
		"stylelint": "^17.15.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-order": "^8.1.1",
		"tslib": "^2.3.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@angular/build": "^22.0.0",
		"@angular/cli": "^22.0.0",
		"@angular/compiler-cli": "^22.0.0",
		"@antfu/eslint-config": "^9.5.1",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@html-eslint/eslint-plugin": "^0.66.1",
		"@html-eslint/parser": "^0.66.1",
		"@types/feather-icons": "^4.29.4",
		"@types/node": "^26.6.3",
		"eslint": "^10.10.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"jsdom": "^28.0.0",
		"lint-staged": "^17.5.1",
		"prettier": "^3.8.1",
		"typescript": "~6.0.2",
		"vitest": "^4.0.8"
