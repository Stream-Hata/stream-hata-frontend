		"*.{ts,mts,cts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.scss": [
			"stylelint --fix",
			"prettier --write"
		],
		"*.{html,json,md,yml,yaml,less,css}": [
			"prettier --write"
		]
	},
	"private": true,
	"packageManager": "pnpm@11.5.2",
	"dependencies": {
		"@angular/cdk": "^22.0.0",
		"@angular/common": "^22.0.0",
		"@angular/compiler": "^22.0.0",
