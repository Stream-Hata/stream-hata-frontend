    "@taiga-ui/layout": "^5.24.0",
    "@types/luxon": "^3.7.5",
    "feather-icons": "^4.29.2",
    "less": "^4.9.1",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "sql-formatter": "^15.9.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
