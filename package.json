{
	"name": "nameless-streamhata",
	"version": "0.7.24-pre-alpha",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"prebuild": "node scripts/write-version.mjs",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"prepare": "husky",
		"commitlint": "commitlint --edit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
