{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamhata.rdpctd.dev/schemas/plugin-manifest-v1.json",
  "title": "StreamHata plugin/mod manifest",
  "description": "Manifest for StreamHata plugins and verified mod packages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "version"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Manifest schema version. Must be 1."
    },
    "kind": {
      "enum": ["plugin", "mod"]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "description": "Stable lowercase id, for example dev.streamhata.obs-tools."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "Semantic version, for example 1.2.3 or 1.2.3-beta.1."
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "authors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "maxItems": 20,
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "maxLength": 80
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
      "description": "Required for plugins. Plugin API major/minor version."
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "description": "Relative entry path inside the archive. Required for plugins."
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "network",
          "filesystem.read",
          "filesystem.write",
          "clipboard.read",
          "clipboard.write",
          "notifications",
          "obs",
          "twitch.chat",
          "stream.state",
          "commands",
          "ui.panel",
          "storage"
        ]
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameVersions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "maxItems": 64
        },
        "loaders": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "maxItems": 16
        },
        "platforms": {
          "type": "array",
          "items": { "enum": ["windows", "linux", "macos", "android", "web"] },
          "uniqueItems": true,
          "maxItems": 5
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "signatureType": {
          "enum": ["minisign", "ed25519"]
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "signatureType": ["signature"],
        "signature": ["signatureType"]
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "trust": { "enum": ["official", "verified", "unknown", "untrusted"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "plugin" } } },
      "then": { "required": ["apiVersion", "entry"] }
    }
  ]
}
